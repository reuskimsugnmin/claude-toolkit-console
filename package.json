{
  "name": "claude-toolkit-console",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "hygiene:check": "node scripts/hygiene-check.mjs",
    "deps:check": "pnpm ls -r --prod --json | node scripts/assert-zero-runtime-deps.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm hygiene:check && pnpm deps:check"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@typescript-eslint/utils": "8.67.0",
    "eslint": "10.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
