{
  "name": "claude-toolkit-console",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "ctk": "pnpm build && node packages/cli/dist/bin/ctk.js",
    "lint": "eslint .",
    "test": "vitest run",
    "hygiene:check": "node scripts/hygiene-check.mjs",
    "deps:check": "pnpm ls -r --prod --json | node scripts/assert-zero-runtime-deps.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm hygiene:check && pnpm deps:check && pnpm gate:managed-policy",
    "gate:managed-policy": "node packages/cli/dist/bin/ctk.js doctor --managed-policy",
    "release:ac39": "CTK_RELEASE_GATE=1 vitest run packages/gen/test/ac-3-9-llm-release-gate.test.ts",
    "release:seal": "node packages/cli/dist/bin/ctk.js verify seal --max-budget-usd 0.50 --timeout-sec 180"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@typescript-eslint/utils": "8.67.0",
    "eslint": "10.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
