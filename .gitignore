# 빌드
dist/
build/
.next/
out/
*.tsbuildinfo

# 환경
.env
.env.*
!.env.example

# 로컬 개인 설정
# ⚠️ 추적이 시작되기 전에 차단해야 한다 — .gitignore는 미추적 파일에만 작용한다
.claude/settings.local.json

# 개인 환경 데이터 — 이 저장소는 public이다. 스냅샷은 별도 private 저장소로 간다
# ⚠️ 저장소 루트에만 앵커한다(선행 슬래시) — 앵커 없이 "snapshots/"만 쓰면 fixtures/catalog/machines/*/snapshots/
# 같은 의도된 합성 픽스처까지 전부 무시돼 실측 트랩이 된다(2026-08-20, Step 1 구현 중 발견).
/snapshots/
*.snapshot.json
/.ctk/

# `ctk web --export-view-model` 산출물 — 절대경로가 없어 위생 정규식에는 안 걸리지만
# 프로젝트 디렉터리 이름·설치 목록·머신 id가 그대로 들어 있다(심사 L4). 관례적인 이름은
# 여기서 막고, 이름을 벗어난 경우는 hygiene-check의 구조 서명이 잡는다.
view-model.json
*.view-model.json

# OS / 에디터
.DS_Store
.vscode/
.idea/

# 런타임 상태
.omc/
.playwright-mcp/

# 테스트 tsconfig가 test/ 옆에 뱉은 컴파일 산출물 (심사 L7)
packages/*/test/**/*.js
packages/*/test/**/*.d.ts
packages/*/test/**/*.d.ts.map

# B4-c: ctk workflow-doc --write의 백업본 (보안 심사 H-3)
*.md.bak
